{
  "name": "bloc-coach",
  "private": true,
  "version": "0.9.0",
  "description": "BLOC Coach: the coach's app. Vite + React + TypeScript, served at /bloc-app/coach/ from the committed dist/ (TECHNICAL §139). Imports ../engine/src as source.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
